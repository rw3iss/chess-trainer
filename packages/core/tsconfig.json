{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src"]
}
