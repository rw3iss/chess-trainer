# ── App ──
NODE_ENV=development
PORT=3000
API_PREFIX=
# Comma-separated list. `*` = all origins (default).
CORS_ORIGINS=*
LOG_LEVEL=debug

# ── Database (postgres) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=server
DB_SYNCHRONIZE=false

# ── Cache (redis) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
