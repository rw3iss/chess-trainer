# Server env. Everything is optional: an empty file boots on SQLite + in-memory cache.
# The repo-root .env is also loaded (LICHESS_TOKEN lives there); this file wins on conflicts.

# ── App ──
NODE_ENV=development
PORT=3000
API_PREFIX=
# Comma-separated list. `*` = all origins (default).
CORS_ORIGINS=*
LOG_LEVEL=debug
# Swagger UI at /docs is on outside production; set true to enable it in production.
SWAGGER_ENABLED=false

# ── Database ──
# sqlite (default, file under apps/server/data/) or postgres.
DB_TYPE=sqlite
DB_PATH=data/chess.sqlite
# Postgres only (required when DB_TYPE=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chess
# Dev-only schema sync (NODE_ENV=development). Migrations run at boot either way.
DB_SYNCHRONIZE=false

# ── Cache (optional) ──
# Empty → in-memory cache. Set to use Redis (explorer cache + room mirror).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Auth ──
# Required in production (min 16 chars). Unset in dev → random per-process secret.
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
GUEST_TTL=86400
# Owner account, created/updated at boot.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me

# ── Openings / explorer ──
# Dataset dir (built by tools/openings-data). Default: ../web/public/data
DATA_DIR=
# Lichess personal token (explorer needs it). Usually set in the repo-root .env.
# LICHESS_TOKEN=
EXPLORER_BASE_URL=https://explorer.lichess.org
EXPLORER_MIN_INTERVAL_MS=1000
EXPLORER_CACHE_TTL=604800
# true → /explorer needs no login
EXPLORER_PUBLIC=false

# ── Engines (optional native binaries) ──
ENGINE_STOCKFISH_PATH=
ENGINE_LC0_PATH=
# lc0 network for the 'lc0' engine
LC0_WEIGHTS=
# Dir with maia-1100.pb.gz … maia-1900.pb.gz (served via lc0, nodes=1)
MAIA_WEIGHTS_DIR=
# User-supplied Komodo Dragon binary (not redistributable)
ENGINE_KOMODO_PATH=
ENGINE_FAIRY_PATH=
ENGINE_MAX_PROCESSES=4
ENGINE_MAX_PER_SOCKET=2
ENGINE_IDLE_TIMEOUT_MS=300000
ENGINE_THREADS=1
ENGINE_HASH_MB=64
ENGINE_ALLOW_GUESTS=false

# ── Rooms ──
# Seconds a room stays in the Redis mirror after its last change.
ROOM_TTL=86400
