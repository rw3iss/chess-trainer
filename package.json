{
	"name": "chess",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"scripts": {
		"dev": "pnpm --filter @chess/web dev",
		"dev:server": "pnpm --filter @chess/server start:dev",
		"build": "pnpm -r build",
		"test": "pnpm -r --if-present test",
		"lint": "pnpm -r --if-present lint",
		"typecheck": "pnpm -r --if-present typecheck",
		"data:openings": "pnpm --filter @chess/openings-data build",
		"data:popularity": "pnpm --filter @chess/openings-data popularity",
		"data:notes": "pnpm --filter @chess/openings-data notes",
		"assets:pieces": "pnpm --filter @chess/piece-assets build"
	}
}
